---
import '../styles/landing.css'
import DownloadDeck from '../components/DownloadDeck.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import markUrl from '@voyalier/brand/voyalier-mark-static.svg?url'
import markDarkUrl from '@voyalier/brand/voyalier-mark-static-dark.svg?url'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const scenes = [
  {
    title: 'See the suggestion beside its source.',
    body: 'Narrow the queue by warning, fact type, or extraction method, then compare the excerpt and decide one suggestion at a time. Nothing becomes a trip fact on its own.',
    image: 'voyalier-evidence-review.jpg',
    alt: 'Voyalier review dialog showing fictional flight and lodging suggestions beside quoted source excerpts and review actions.',
    caption: 'Review · fictional sample confirmation',
  },
  {
    title: 'Prepare without borrowing authority.',
    body: 'Visa and entry preparation points back to the official source, records when it was read, and says plainly what Voyalier has not verified.',
    image: 'voyalier-visa-cockpit.jpg',
    alt: 'Voyalier visa and entry preparation view with a non-authority warning, official-source link, and six-step guide.',
    caption: 'Prepare · visa and entry cockpit',
  },
  {
    title: 'Let the finding open its next step.',
    body: 'Readiness points to the existing schedule, Stay form, review queue, Visa, or Prepare context. It moves the traveler; it never marks a high-stakes requirement cleared.',
    image: 'voyalier-readiness-route.jpg',
    alt: 'Voyalier readiness panel for a fictional Kyoto trip, with local next-step actions for schedule, lodging, pending review, entry, and health context.',
    caption: 'Return · local readiness routes',
  },
]

const productTruths = [
  ['Your trip', 'Stored locally in one SQLite workspace.'],
  ['Imported details', 'Candidates until you review them.'],
  ['Planning checks', 'Deterministic rules, available without AI.'],
  ['Readiness actions', 'Open local context; they do not clear requirements.'],
  ['Search detours', 'Carry the private query and return path in browser history.'],
  ['Connected context', 'Fetched only after an explicit action.'],
  ['Sharing', 'Built from a redacted model that excludes names and confirmation codes.'],
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        let storedTheme = ''
        try {
          storedTheme = localStorage.getItem('starlight-theme') || ''
        } catch {
          storedTheme = ''
        }
        const systemTheme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'
        document.documentElement.dataset.theme =
          storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : systemTheme
      })()
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Voyalier is a local-first, evidence-backed trip workspace for reviewing confirmations, preparing deliberately, and keeping travel day quiet." />
    <meta property="og:title" content="Voyalier — Plan the trip. Keep the evidence." />
    <meta property="og:description" content="A calm local-first trip workspace. Useful without AI; connected only when you ask." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://udhawan97.github.io/Voyalier/" />
    <meta property="og:image" content="https://udhawan97.github.io/Voyalier/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Voyalier — Plan the trip. Keep the evidence. Local-first, evidence-backed, AI optional." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://udhawan97.github.io/Voyalier/og.png" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>Voyalier — Plan the trip. Keep the evidence.</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="nav-shell">
      <nav class="site-nav" aria-label="Primary">
        <a class="wordmark" href={`${base}/`} aria-label="Voyalier home">
          <img class="wordmark-mark wordmark-mark-light" src={markUrl} width="96" height="96" alt="" />
          <img class="wordmark-mark wordmark-mark-dark" src={markDarkUrl} width="96" height="96" alt="" />
          <span>Voyalier</span>
        </a>
        <div class="site-nav__links">
          <a href="#tour">Tour</a>
          <a href="#trust">Trust</a>
          <a href={`${base}/introduction/`}>Docs</a>
        </div>
        <div class="site-nav__actions">
          <ThemeToggle />
          <a class="nav-download" href="#download" aria-label="Download Voyalier">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 21h14" /></svg>
            <span>Download</span>
          </a>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy reveal" style="--i: 0">
          <h1 id="hero-title">Plan the trip.<br />Keep the evidence.</h1>
          <p class="hero-lede">Voyalier gathers confirmations, research, readiness, and the plan itself into one calm workspace on your device. Suggestions wait for you. Findings point to their next local step. Connected help waits for a click.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#download">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 21h14" /></svg>
              Choose a download
            </a>
            <a class="text-link" href="#tour">See the workspace <span aria-hidden="true">↓</span></a>
          </div>
          <ul class="hero-contract" aria-label="Voyalier product contract">
            <li>Local first</li>
            <li>No account</li>
            <li>AI optional</li>
          </ul>
        </div>

        <figure class="hero-proof reveal" style="--i: 1">
          <img src={`${base}/assets/screenshots/voyalier-trip-workspace.jpg`} width="1440" height="900" fetchpriority="high" decoding="async" alt="Current-source Voyalier dark workspace for a fictional Kyoto trip, showing its destination header, Today, pending suggestions, and Blueprint." />
          <figcaption><span>Current source UI</span><span>Disposable sample trip · no personal data</span></figcaption>
        </figure>
      </section>

      <ol class="route-ledger" aria-label="Voyalier evidence and continuity register">
        <li><span>01</span><strong>Source</strong><p>Keep the imported origin.</p></li>
        <li><span>02</span><strong>Review</strong><p>Approve one candidate at a time.</p></li>
        <li><span>03</span><strong>Plan</strong><p>Use deterministic local checks.</p></li>
        <li><span>04</span><strong>Return</strong><p>Come back to the exact context.</p></li>
      </ol>

      <section class="truths" aria-labelledby="truths-title">
        <header class="section-heading">
          <h2 id="truths-title">A travel workspace that knows what it knows.</h2>
          <p>Voyalier helps organize and check a trip. It does not book it, watch it in the background, or inherit authority from a government page.</p>
        </header>
        <dl class="truth-ledger">
          {productTruths.map(([term, detail]) => (
            <div>
              <dt>{term}</dt>
              <dd>{detail}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="tour" id="tour" aria-labelledby="tour-title">
        <div class="tour__intro">
          <h2 id="tour-title">From an uncertain document to a usable day.</h2>
          <p>Three current-source views show the whole idea: keep the source, preserve the uncertainty, bring forward only what the traveler approved, and keep the return path intact.</p>
          <a class="text-link" href={`${base}/getting-started/`}>Read the first-run guide <span aria-hidden="true">→</span></a>
        </div>
        <div class="tour__scenes">
          {scenes.map((scene) => (
            <figure class="tour-scene">
              <img src={`${base}/assets/screenshots/${scene.image}`} width="1440" height="900" loading="lazy" decoding="async" alt={scene.alt} />
              <figcaption>
                <p class="tour-scene__caption">{scene.caption}</p>
                <h3>{scene.title}</h3>
                <p>{scene.body}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="download" id="download" aria-labelledby="download-title">
        <header class="section-heading section-heading--download">
          <h2 id="download-title">Take the quiet route in.</h2>
          <p>Pick your machine. Every option keeps your trips on this computer; only how you open Voyalier changes.</p>
        </header>
        <DownloadDeck />
        <p class="download-note">The desktop installers are public beta builds without paid platform publisher identity; macOS is not notarized and Windows may show SmartScreen. Releases publish SHA-256 checksums, and Voyalier verifies signed updater downloads before installation.</p>
        <a class="text-link" href={`${base}/download/`}>Read the install guide <span aria-hidden="true">→</span></a>
      </section>

      <section class="trust" id="trust" aria-labelledby="trust-title">
        <div class="trust__copy">
          <h2 id="trust-title">The useful parts do not need a model.</h2>
          <p>Parsing, validation, search, readiness, recommendations, Today, and redaction are deterministic. Optional Ollama, OpenAI, or Anthropic help sits beside that loop with preview and consent.</p>
          <ul>
            <li><strong>Imports are untrusted.</strong> Extracted details remain candidates until review.</li>
            <li><strong>Live context is dated.</strong> Advice and weather keep source and fetched time.</li>
            <li><strong>Remote AI is previewed.</strong> The exact redacted payload is visible before it leaves.</li>
            <li><strong>Sharing starts with exclusion.</strong> Names and confirmation codes never enter the brief model.</li>
          </ul>
          <a class="text-link text-link-light" href={`${base}/privacy/`}>Read the privacy contract <span aria-hidden="true">→</span></a>
        </div>
        <figure class="trust__diagram">
          <img src={`${base}/assets/voyalier-evidence-pipeline.svg`} width="1440" height="880" loading="lazy" decoding="async" alt="Voyalier evidence flow from untrusted input through human review into confirmed facts and deterministic views, with connected sources kept in a separate explicit lane." />
          <figcaption>Evidence and assistance remain separate lanes.</figcaption>
        </figure>
      </section>

      <section class="architecture" aria-labelledby="architecture-title">
        <header class="section-heading">
          <h2 id="architecture-title">One product core. Two local ways to run it.</h2>
          <p>The native desktop shell uses direct Tauri IPC. The browser development path uses a loopback-only server. Both call the same application service and deterministic Rust core.</p>
          <div class="architecture__links">
            <a class="text-link" href={`${base}/architecture/`}>Read the architecture <span aria-hidden="true">→</span></a>
            <a class="text-link" href="https://github.com/udhawan97/Voyalier">Browse the source <span aria-hidden="true">↗</span></a>
          </div>
        </header>
        <figure>
          <img src={`${base}/assets/voyalier-system-architecture.svg`} width="1440" height="900" loading="lazy" decoding="async" alt="Voyalier architecture with one shared interface, desktop IPC and loopback browser transports, shared application services, deterministic core, local state, and explicit connected sources." />
        </figure>
      </section>
    </main>

    <footer class="foot-mast">
      <div>
        <a class="foot-mast__wordmark" href={`${base}/`} aria-label="Voyalier home">
          <img src={markDarkUrl} width="96" height="96" alt="" />
          <span>Voyalier</span>
        </a>
        <p>The plan stays useful when the signal disappears.</p>
      </div>
      <nav aria-label="Footer navigation">
        <a href={`${base}/download/`}>Download</a>
        <a href={`${base}/introduction/`}>Docs</a>
        <a href={`${base}/privacy/`}>Privacy</a>
        <a href="https://github.com/udhawan97/Voyalier">GitHub</a>
      </nav>
      <p class="foot-mast__meta">Open source under Apache-2.0 · Public beta · Local first</p>
    </footer>
  </body>
</html>
