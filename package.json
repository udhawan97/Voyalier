{
  "name": "voyalier",
  "version": "0.11.1",
  "private": true,
  "description": "A local-first travel intelligence workspace.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "node scripts/dev-launcher.mjs",
    "dev:web": "pnpm --filter @voyalier/web dev",
    "dev:docs": "pnpm --filter @voyalier/docs dev",
    "build": "pnpm --filter @voyalier/contracts typecheck && pnpm --filter @voyalier/web build && pnpm --filter @voyalier/docs build",
    "typecheck": "pnpm --filter @voyalier/contracts typecheck && pnpm --filter @voyalier/web typecheck",
    "lint": "pnpm --filter @voyalier/web lint",
    "test": "node --test scripts/*.test.mjs && pnpm --filter @voyalier/web test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6"
  }
}
